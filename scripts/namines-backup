#!/usr/bin/env bash
# =============================================================================
# namines-backup — Veritabani (PostgreSQL/Supabase) + Yapilandirma Yedekleme Araci
#
# Kullanim:
#   namines-backup                    -> Tam yedek (SIFRELI): DB dump + app_data + config
#                                        (sirlar AYRI, ayri sifreli arsivde)
#   namines-backup list               -> Mevcut yedekleri ve boyutlarini listeler
#   namines-backup verify [dosya]     -> En son (veya verilen) yedegin DB dump'ini gecici bir
#                                        postgres container'ina yukler, saglik sorgulari calistirir
#   namines-backup restore <dosya>    -> Arsivi cozer / acar (DB'ye YAZMAZ, komutu gosterir)
#   namines-backup clean              -> Eski yedekleri temizler (yerel + uzak)
#
# Yapilandirma (ortam degiskeni ya da $NAMINES_BACKUP_CONF, varsayilan /etc/namines-backup.conf):
#   BACKUP_AGE_RECIPIENT=age1...           age PUBLIC anahtari (onerilen; birden cok icin virgulle)
#   BACKUP_AGE_IDENTITY_FILE=/yol/key.txt  geri yukleme/verify icin age OZEL anahtari (sunucuda
#                                          KALICI tutmayin; yalnizca gerektiginde saglayin)
#   BACKUP_GPG_PASSPHRASE_FILE=/yol/pass   age yoksa gpg --symmetric yedegi (dosya modu 600)
#   BACKUP_RCLONE_REMOTE=r2:bucket/prod    opsiyonel off-site (S3/B2/R2); yalnizca SIFRELI arsivler yuklenir
#   BACKUP_REMOTE_RETENTION_DAYS=30        uzak saklama suresi
#   BACKUP_PG_IMAGE=postgres:17-alpine     pg_dump imaji (sunucu major'u ile ayni olmali)
#   BACKUP_VERIFY_MIN_TABLES=20            verify: beklenen en az tablo sayisi
#   BACKUP_ALLOW_UNENCRYPTED=1             YALNIZCA yerel; sifresiz yedegin uzaga yuklenmesi her zaman reddedilir
# =============================================================================
set -euo pipefail

CONF_FILE="${NAMINES_BACKUP_CONF:-/etc/namines-backup.conf}"
# shellcheck disable=SC1090
if [ -f "$CONF_FILE" ]; then . "$CONF_FILE"; fi

REPO_DIR="${REPO_DIR:-/home/ubuntu/namines}"
BACKUP_ROOT="${BACKUP_ROOT:-/home/ubuntu/backups}"
COMPOSE_FILE="${COMPOSE_FILE:-$REPO_DIR/docker-compose.oracle.yml}"
RETENTION_DAYS=14
# Yaş ne olursa olsun en yeni N arşiv HİÇBİR ZAMAN silinmez: yedekleme sessizce
# bozulursa (yeni arşiv üretilemezse) retention eldeki son sağlam yedekleri de
# silip geriye hiçbir şey bırakmazdı.
KEEP_MIN=7
# Gerçek bir pg_dump şema bile olsa bundan büyüktür; boş/kesik dump'ı yakalar.
MIN_DUMP_BYTES=1024

PG_IMAGE="${BACKUP_PG_IMAGE:-postgres:17-alpine}"
AGE_RECIPIENT="${BACKUP_AGE_RECIPIENT:-}"
AGE_IDENTITY_FILE="${BACKUP_AGE_IDENTITY_FILE:-}"
GPG_PASS_FILE="${BACKUP_GPG_PASSPHRASE_FILE:-}"
RCLONE_REMOTE="${BACKUP_RCLONE_REMOTE:-}"
REMOTE_RETENTION_DAYS="${BACKUP_REMOTE_RETENTION_DAYS:-30}"
VERIFY_MIN_TABLES="${BACKUP_VERIFY_MIN_TABLES:-20}"
ALLOW_UNENCRYPTED="${BACKUP_ALLOW_UNENCRYPTED:-0}"

GREEN='\033[0;32m'
CYAN='\033[0;36m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

# Uyari/hata stderr'e: $(...) ile yakalanan fonksiyonlarin (enc_mode vb.) ciktisini kirletmesin.
log_info()  { echo -e "${CYAN}[namines-backup]${NC} $1"; }
log_ok()    { echo -e "${GREEN}[OK]${NC} $1"; }
log_warn()  { echo -e "${YELLOW}[UYARI]${NC} $1" >&2; }
log_err()   { echo -e "${RED}[HATA]${NC} $1" >&2; }

mkdir -p "$BACKUP_ROOT"
chmod 700 "$BACKUP_ROOT"

extract_db_param() {
  local key="$1"
  local conn_line
  conn_line=$(grep -E 'ConnectionStrings__DefaultConnection=' "$COMPOSE_FILE" "$REPO_DIR/.env" 2>/dev/null | head -n 1 || true)
  echo "$conn_line" | sed -n "s/.*${key}=\([^;\"]*\).*/\1/p"
}

# ── Sifreleme ────────────────────────────────────────────────────────────────
# Mod: age (onerilen) > gpg-symmetric > none (yalnizca BACKUP_ALLOW_UNENCRYPTED=1).
enc_mode() {
  if [ -n "$AGE_RECIPIENT" ]; then
    command -v age >/dev/null 2>&1 || { log_err "BACKUP_AGE_RECIPIENT tanimli ama 'age' kurulu degil (apt install age)."; return 1; }
    echo age
  elif [ -n "$GPG_PASS_FILE" ]; then
    command -v gpg >/dev/null 2>&1 || { log_err "BACKUP_GPG_PASSPHRASE_FILE tanimli ama 'gpg' kurulu degil."; return 1; }
    [ -s "$GPG_PASS_FILE" ] || { log_err "gpg parola dosyasi bos/yok: $GPG_PASS_FILE"; return 1; }
    echo gpg
  elif [ "$ALLOW_UNENCRYPTED" = "1" ]; then
    echo none
  else
    log_err "Sifreleme yapilandirilmadi. BACKUP_AGE_RECIPIENT (onerilen) ya da BACKUP_GPG_PASSPHRASE_FILE tanimlayin."
    log_err "Sifresiz yedek alinmaz (DB dump'i ve sirlar acik metin olurdu)."
    return 1
  fi
}

enc_ext() {
  case "$1" in
    age) echo ".age" ;;
    gpg) echo ".gpg" ;;
    *)   echo "" ;;
  esac
}

# stdin -> sifreli dosya ($2)
encrypt_to() {
  local mode="$1" out="$2"
  case "$mode" in
    age)
      local args=() r recips=()
      IFS=',' read -ra recips <<< "$AGE_RECIPIENT"
      for r in "${recips[@]}"; do args+=(-r "$r"); done
      age "${args[@]}" -o "$out"
      ;;
    gpg)
      gpg --batch --yes --quiet --pinentry-mode loopback --passphrase-file "$GPG_PASS_FILE" \
          --symmetric --cipher-algo AES256 -o "$out"
      ;;
    none) cat > "$out" ;;
  esac
}

# sifreli (ya da duz) dosya ($1) -> stdout
decrypt_from() {
  local file="$1"
  case "$file" in
    *.age)
      if [ -z "$AGE_IDENTITY_FILE" ] || [ ! -f "$AGE_IDENTITY_FILE" ]; then
        log_err "age OZEL anahtari gerekli: BACKUP_AGE_IDENTITY_FILE=/yol/key.txt"; return 1
      fi
      age -d -i "$AGE_IDENTITY_FILE" "$file"
      ;;
    *.gpg)
      if [ -z "$GPG_PASS_FILE" ] || [ ! -s "$GPG_PASS_FILE" ]; then
        log_err "gpg parola dosyasi gerekli: BACKUP_GPG_PASSPHRASE_FILE"; return 1
      fi
      gpg --batch --quiet --pinentry-mode loopback --passphrase-file "$GPG_PASS_FILE" -d "$file"
      ;;
    *) cat "$file" ;;
  esac
}

# ── Listeleme / saklama ──────────────────────────────────────────────────────
# Yedek arsivleri, .sha256/.partial haric; en yeni once (ad zaman damgasi icerir).
list_archives() {
  local prefix="$1"
  { ls -1 "$BACKUP_ROOT"/"${prefix}"* 2>/dev/null || true; } | { grep -Ev '\.(sha256|partial)$' || true; } | sort -r
}

prune_local_prefix() {
  local prefix="$1" f idx=0
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    idx=$((idx + 1))
    if [ "$idx" -le "$KEEP_MIN" ]; then
      continue
    fi
    if [ -n "$(find "$f" -maxdepth 0 -mtime +"$RETENTION_DAYS" 2>/dev/null)" ]; then
      rm -f -- "$f" "${f}.sha256"
    fi
  done < <(list_archives "$prefix")
}

prune_old_backups() {
  prune_local_prefix "namines-backup-"
  prune_local_prefix "namines-secrets-"
}

# Uzak depoda ada gomulu tarihe gore temizlik; en yeni KEEP_MIN dosya korunur.
prune_remote() {
  [ -n "$RCLONE_REMOTE" ] || return 0
  command -v rclone >/dev/null 2>&1 || return 0
  local cutoff prefix f idx name_date
  cutoff=$(date -d "-${REMOTE_RETENTION_DAYS} days" +%F)
  for prefix in namines-backup- namines-secrets-; do
    idx=0
    while IFS= read -r f; do
      [ -n "$f" ] || continue
      idx=$((idx + 1))
      [ "$idx" -le "$KEEP_MIN" ] && continue
      name_date=$(echo "$f" | sed -n "s/^${prefix}\([0-9]\{4\}-[0-9]\{2\}-[0-9]\{2\}\)_.*/\1/p")
      if [ -n "$name_date" ] && [[ "$name_date" < "$cutoff" ]]; then
        rclone deletefile "${RCLONE_REMOTE}/${f}" || true
        rclone deletefile "${RCLONE_REMOTE}/${f}.sha256" 2>/dev/null || true
      fi
    done < <({ rclone lsf --files-only --include "${prefix}*" "$RCLONE_REMOTE" 2>/dev/null || true; } | { grep -v '\.sha256$' || true; } | sort -r)
  done
}

upload_remote() {
  local file="$1" mode="$2"
  [ -n "$RCLONE_REMOTE" ] || return 0
  if [ "$mode" = "none" ]; then
    log_err "Sifresiz arsiv uzak depoya YUKLENMEZ: $file"
    return 1
  fi
  command -v rclone >/dev/null 2>&1 || { log_err "BACKUP_RCLONE_REMOTE tanimli ama 'rclone' kurulu degil."; return 1; }
  log_info "Off-site yukleme: $(basename "$file") -> $RCLONE_REMOTE"
  rclone copyto --checksum "$file" "${RCLONE_REMOTE}/$(basename "$file")"
  rclone copyto --checksum "${file}.sha256" "${RCLONE_REMOTE}/$(basename "$file").sha256"
  log_ok "Off-site yukleme tamamlandi."
}

verify_sha() {
  local archive="$1"
  if [ -f "${archive}.sha256" ]; then
    local expected actual
    expected=$(awk '{print $1}' "${archive}.sha256")
    actual=$(sha256sum "$archive" | awk '{print $1}')
    if [ "$expected" != "$actual" ]; then
      log_err "SHA-256 uyusmuyor, arsiv bozuk veya degistirilmis: $archive"
      return 1
    fi
    log_ok "SHA-256 dogrulandi."
  else
    log_warn "${archive}.sha256 bulunamadi; arsivin butunlugu DOGRULANAMADI."
  fi
}

resolve_archive() {
  local a="$1"
  if [ ! -f "$a" ] && [ -f "$BACKUP_ROOT/$a" ]; then a="$BACKUP_ROOT/$a"; fi
  if [ ! -f "$a" ]; then log_err "Dosya bulunamadi: $1"; return 1; fi
  echo "$a"
}

cmd="${1:-run}"

case "$cmd" in
  list|ls)
    log_info "Mevcut yedekler ($BACKUP_ROOT):"
    if [ -n "$(list_archives "namines-")" ]; then
      list_archives "namines-" | while IFS= read -r f; do
        echo "  $(basename "$f")  ($(du -h "$f" | awk '{print $1}'))"
      done
      echo ""
      log_ok "Toplam yedek klasoru boyutu: $(du -sh "$BACKUP_ROOT" | awk '{print $1}')"
    else
      log_warn "Henuz alinmis bir yedek bulunmuyor."
    fi
    exit 0
    ;;

  clean)
    log_info "${RETENTION_DAYS} gunden eski yedekler siliniyor..."
    prune_old_backups
    prune_remote
    log_ok "Eski yedek temizligi tamamlandi (en yeni ${KEEP_MIN} arsiv her zaman korunur)."
    exit 0
    ;;

  restore)
    if [ -z "${2:-}" ]; then
      log_err "Lutfen geri yuklenecek yedek dosyasini belirtin."
      echo "Ornek: namines-backup restore $BACKUP_ROOT/namines-backup-XXXX.tar.gz.age"
      exit 1
    fi
    ARCHIVE=$(resolve_archive "$2") || exit 1
    verify_sha "$ARCHIVE"

    # Tahmin edilebilir /tmp adı (symlink saldırısı) yerine 0700 mktemp.
    umask 077
    RESTORE_DIR=$(mktemp -d "/tmp/namines-restore-XXXXXX")
    log_info "Arsiv aciliyor: $ARCHIVE -> $RESTORE_DIR"
    decrypt_from "$ARCHIVE" | tar -xz -C "$RESTORE_DIR"

    log_ok "Yedek icerigi basariyla acildi: $RESTORE_DIR"
    ls -la "$RESTORE_DIR"
    echo ""
    log_info "Veritabanini geri yuklemek icin (HEDEF DB'yi once dogrulayin! --clean mevcut nesneleri siler):"
    echo "  gunzip -c $RESTORE_DIR/supabase-db.sql.gz | sudo docker run --rm -i -e PGPASSWORD=\"\$DB_PASS\" ${PG_IMAGE} psql -v ON_ERROR_STOP=1 -h \"\$DB_HOST\" -p \"\$DB_PORT\" -U \"\$DB_USER\" -d \"\$DB_NAME\""
    log_warn "Isiniz bitince $RESTORE_DIR dizinini silin (icinde acik metin veri var)."
    exit 0
    ;;

  verify)
    # En son (ya da verilen) ana arsivin DB dump'ini GECICI bir postgres container'ina
    # yukleyip temel saglik sorgularini calistirir. Uretim DB'ye ASLA yazmaz.
    command -v docker >/dev/null 2>&1 || { log_err "verify icin docker gerekli."; exit 1; }
    if [ -n "${2:-}" ]; then
      ARCHIVE=$(resolve_archive "$2") || exit 1
    else
      ARCHIVE=$(list_archives "namines-backup-" | head -n 1)
      if [ -z "$ARCHIVE" ]; then log_err "Dogrulanacak yedek yok."; exit 1; fi
    fi
    log_info "Dogrulanacak arsiv: $ARCHIVE"
    verify_sha "$ARCHIVE"

    umask 077
    VDIR=$(mktemp -d "/tmp/namines-verify-XXXXXX")
    CNAME="namines-verify-$$"
    cleanup_verify() {
      sudo docker rm -f "$CNAME" >/dev/null 2>&1 || true
      rm -rf "$VDIR"
    }
    trap cleanup_verify EXIT

    decrypt_from "$ARCHIVE" | tar -xz -C "$VDIR" ./supabase-db.sql.gz
    gzip -t "$VDIR/supabase-db.sql.gz"

    # Dump basligindaki sunucu surumunden postgres major'u: farkli major'a geri yukleme yanlis alarm verir.
    DUMP_MAJOR=$( { gunzip -c "$VDIR/supabase-db.sql.gz" 2>/dev/null || true; } | head -n 40 \
      | sed -n 's/^-- Dumped from database version \([0-9]\{1,\}\).*/\1/p' | head -n 1)
    if [ -z "$DUMP_MAJOR" ]; then
      DUMP_MAJOR="${PG_IMAGE##*:}"
      DUMP_MAJOR="${DUMP_MAJOR%%-*}"
    fi
    VIMAGE="postgres:${DUMP_MAJOR}-alpine"
    log_info "Gecici container: $VIMAGE"

    sudo docker run -d --rm --name "$CNAME" -e POSTGRES_PASSWORD=verify -e POSTGRES_DB=verify "$VIMAGE" >/dev/null
    ready=0
    for _ in $(seq 1 60); do
      if sudo docker exec "$CNAME" pg_isready -U postgres -d verify >/dev/null 2>&1; then ready=1; break; fi
      sleep 1
    done
    if [ "$ready" -ne 1 ]; then log_err "Gecici postgres hazir olmadi."; exit 1; fi
    sleep 2 # initdb'nin gecici sunucudan gercek sunucuya gecisi

    log_info "Dump geri yukleniyor..."
    if ! gunzip -c "$VDIR/supabase-db.sql.gz" | sudo docker exec -i "$CNAME" psql -q -v ON_ERROR_STOP=1 -U postgres -d verify >"$VDIR/restore.log" 2>&1; then
      log_err "Geri yukleme HATA verdi:"
      tail -n 20 "$VDIR/restore.log" >&2
      exit 1
    fi

    q() { sudo docker exec "$CNAME" psql -U postgres -d verify -tA -c "$1"; }
    TABLES=$(q "SELECT count(*) FROM information_schema.tables WHERE table_schema='public' AND table_type='BASE TABLE'")
    MIGS=$(q 'SELECT count(*) FROM "__EFMigrationsHistory"' 2>/dev/null || echo 0)
    USERS=$(q 'SELECT count(*) FROM "AspNetUsers"' 2>/dev/null || echo 0)
    PROJECTS=$(q 'SELECT count(*) FROM "CloudProjects"' 2>/dev/null || echo 0)

    fail=0
    echo "  Tablo sayisi          : $TABLES (beklenen >= $VERIFY_MIN_TABLES)"
    echo "  __EFMigrationsHistory : $MIGS"
    echo "  AspNetUsers           : $USERS"
    echo "  CloudProjects         : $PROJECTS"
    if [ "${TABLES:-0}" -lt "$VERIFY_MIN_TABLES" ]; then log_err "Tablo sayisi beklenenden az."; fail=1; fi
    if [ "${MIGS:-0}" -le 0 ]; then log_err "__EFMigrationsHistory bos: dump eksik olabilir."; fail=1; fi

    # Uretim bos degilse yedek de bos olmamali. Uretim sayisi okunamazsa bu kontrol atlanir.
    DB_HOST=$(extract_db_param "Host"); DB_PORT=$(extract_db_param "Port")
    DB_NAME=$(extract_db_param "Database"); DB_USER=$(extract_db_param "Username"); DB_PASS=$(extract_db_param "Password")
    if [ -n "$DB_HOST" ] && [ -n "$DB_USER" ] && [ -n "$DB_PASS" ]; then
      PROD_USERS=$(sudo docker run --rm -e PGPASSWORD="$DB_PASS" "$PG_IMAGE" \
        psql -h "$DB_HOST" -p "${DB_PORT:-5432}" -U "$DB_USER" -d "${DB_NAME:-postgres}" -tA \
        -c 'SELECT count(*) FROM "AspNetUsers"' 2>/dev/null || echo "")
      if [ -n "$PROD_USERS" ] && [ "$PROD_USERS" -gt 0 ] 2>/dev/null; then
        echo "  Uretim AspNetUsers    : $PROD_USERS"
        if [ "${USERS:-0}" -le 0 ]; then log_err "Uretimde $PROD_USERS kullanici var ama yedekte 0."; fail=1; fi
      fi
    else
      log_warn "Uretim baglantisi okunamadi; 'uretim bos degil' karsilastirmasi atlandi."
    fi

    if [ "$fail" -eq 0 ]; then
      log_ok "DOGRULAMA BASARILI: $(basename "$ARCHIVE")"
      exit 0
    fi
    log_err "DOGRULAMA BASARISIZ: $(basename "$ARCHIVE")"
    exit 1
    ;;

  run|backup|"")
    TIMESTAMP=$(date +"%Y-%m-%d_%H-%M-%S")
    MODE=$(enc_mode) || exit 1
    EXT=$(enc_ext "$MODE")
    WORK_DIR=$(mktemp -d "/tmp/namines-bkp-${TIMESTAMP}-XXXXXX")
    SECRETS_DIR=$(mktemp -d "/tmp/namines-bkp-secrets-${TIMESTAMP}-XXXXXX")
    ARCHIVE_PATH="${BACKUP_ROOT}/namines-backup-${TIMESTAMP}.tar.gz${EXT}"
    SECRETS_ARCHIVE_PATH="${BACKUP_ROOT}/namines-secrets-${TIMESTAMP}.tar.gz${EXT}"
    PARTIAL_PATH="${ARCHIVE_PATH}.partial"
    SECRETS_PARTIAL_PATH="${SECRETS_ARCHIVE_PATH}.partial"

    trap 'rm -rf "$WORK_DIR" "$SECRETS_DIR" "$PARTIAL_PATH" "$SECRETS_PARTIAL_PATH"' EXIT

    log_info "Yedekleme baslatiliyor ($TIMESTAMP, sifreleme: $MODE)..."
    if [ "$MODE" = "none" ]; then log_warn "SIFRESIZ yedek (BACKUP_ALLOW_UNENCRYPTED=1): uzak depoya yuklenmeyecek."; fi
    mkdir -p "$WORK_DIR/config" "$WORK_DIR/app_data" "$SECRETS_DIR/config"

    # 1. PostgreSQL Veritabani Yedegi (pg_dump)
    DB_HOST=$(extract_db_param "Host")
    DB_PORT=$(extract_db_param "Port")
    DB_NAME=$(extract_db_param "Database")
    DB_USER=$(extract_db_param "Username")
    DB_PASS=$(extract_db_param "Password")

    # DB dump ZORUNLU: bağlantı bilgisi yoksa ya da dump bozuksa yedek BAŞARISIZDIR.
    if [ -z "$DB_HOST" ] || [ -z "$DB_USER" ] || [ -z "$DB_PASS" ]; then
      log_err "[1/4] Veritabani baglanti bilgisi okunamadi (ConnectionStrings__DefaultConnection). Yedek ALINMADI."
      exit 1
    fi

    log_info "[1/4] PostgreSQL veritabani tam yedegi aliniyor ($DB_HOST)..."
    DUMP_FILE="$WORK_DIR/supabase-db.sql.gz"
    sudo docker run --rm \
      -e PGPASSWORD="$DB_PASS" \
      "$PG_IMAGE" \
      pg_dump -h "$DB_HOST" -p "${DB_PORT:-5432}" -U "$DB_USER" -d "${DB_NAME:-postgres}" \
      --no-owner --no-acl --clean --if-exists \
      | gzip -9 > "$DUMP_FILE"
    if ! gzip -t "$DUMP_FILE" 2>/dev/null; then
      log_err "[1/4] DB dump gecerli bir gzip degil. Yedek ALINMADI."
      exit 1
    fi
    DUMP_BYTES=$(stat -c %s "$DUMP_FILE")
    if [ "$DUMP_BYTES" -lt "$MIN_DUMP_BYTES" ]; then
      log_err "[1/4] DB dump supheli derecede kucuk (${DUMP_BYTES} bayt). Yedek ALINMADI."
      exit 1
    fi
    DB_SIZE=$(du -h "$DUMP_FILE" | awk '{print $1}')
    log_ok "Veritabani yedegi tamamlandi ($DB_SIZE)."

    # 2. Konfigurasyon. SIRLAR (.env ve DB parolasi iceren compose dosyasi) DB dump'indan
    #    AYRI arsivde: ayni dosyada olsalardi tek bir sizinti hem veriyi hem anahtarlari verirdi.
    log_info "[2/4] Konfigurasyon: sirlar ayri arsive, sirsiz dosyalar ana arsive aliniyor..."
    if [ -f "$REPO_DIR/.env" ]; then cp "$REPO_DIR/.env" "$SECRETS_DIR/config/.env"; fi
    if [ -f "$COMPOSE_FILE" ]; then cp "$COMPOSE_FILE" "$SECRETS_DIR/config/docker-compose.oracle.yml"; fi
    if [ -f "/etc/caddy/Caddyfile" ]; then
      sudo cp "/etc/caddy/Caddyfile" "$WORK_DIR/config/Caddyfile"
      sudo chown "$(id -un):$(id -gn)" "$WORK_DIR/config/Caddyfile"
    fi

    # 3. Uygulama Kalici Verileri (/home/ubuntu/app_data)
    log_info "[3/4] Uygulama verileri (/home/ubuntu/app_data) yedekleniyor..."
    if [ -d "/home/ubuntu/app_data" ]; then
      sudo cp -r /home/ubuntu/app_data/. "$WORK_DIR/app_data/" 2>/dev/null || true
      sudo chown -R "$(id -un):$(id -gn)" "$WORK_DIR/app_data"
    fi

    # 4. Sistem & Git Metadata
    GIT_COMMIT=$(cd "$REPO_DIR" && git rev-parse HEAD 2>/dev/null || echo "unknown")
    cat > "$WORK_DIR/metadata.txt" <<EOF
Backup Timestamp : $TIMESTAMP
Server Hostname  : $(hostname)
Git Commit       : $GIT_COMMIT
Database Host    : ${DB_HOST:-none}
Encryption       : $MODE
Docker Status    : $(sudo docker ps --format '{{.Names}}: {{.Status}}' | tr '\n' ' ')
EOF

    log_info "[4/4] Sifreli arsivler ve SHA-256 imzalari olusturuluyor..."
    # Önce .partial'a yaz, doğrula, sonra yeniden adlandır: yarım kalan arşiv
    # geçerli bir yedek gibi görünmesin.
    umask 077
    tar -cz -C "$WORK_DIR" . | encrypt_to "$MODE" "$PARTIAL_PATH"
    tar -cz -C "$SECRETS_DIR" . | encrypt_to "$MODE" "$SECRETS_PARTIAL_PATH"
    # Sifresiz modda gzip testi; sifreliyse icerik dogrulamasi 'verify' alt komutunda yapilir.
    if [ "$MODE" = "none" ]; then gzip -t "$PARTIAL_PATH"; fi
    if [ ! -s "$PARTIAL_PATH" ] || [ ! -s "$SECRETS_PARTIAL_PATH" ]; then
      log_err "Arsiv bos uretildi."
      exit 1
    fi
    chmod 600 "$PARTIAL_PATH" "$SECRETS_PARTIAL_PATH"
    mv "$PARTIAL_PATH" "$ARCHIVE_PATH"
    mv "$SECRETS_PARTIAL_PATH" "$SECRETS_ARCHIVE_PATH"
    sha256sum "$ARCHIVE_PATH" > "${ARCHIVE_PATH}.sha256"
    sha256sum "$SECRETS_ARCHIVE_PATH" > "${SECRETS_ARCHIVE_PATH}.sha256"

    # Off-site (opsiyonel). Basarisizsa komut hata ile biter (yerel kopya kalir, alarm uretilir).
    upload_remote "$ARCHIVE_PATH" "$MODE"
    upload_remote "$SECRETS_ARCHIVE_PATH" "$MODE"

    # Eski yedekleri otomatik temizle (yalnızca bu yedek BAŞARIYLA yazıldıktan sonra)
    prune_old_backups
    prune_remote

    FINAL_SIZE=$(du -h "$ARCHIVE_PATH" | awk '{print $1}')
    log_ok "Yedekleme basariyla tamamlandi!"
    echo -e "  Dosya  : ${GREEN}${ARCHIVE_PATH}${NC} (${FINAL_SIZE})"
    echo -e "  Sirlar : ${SECRETS_ARCHIVE_PATH}  (AYRI sakla / ayri erisim)"
    echo -e "  Imza   : ${ARCHIVE_PATH}.sha256"
    ;;

  *)
    echo "Kullanim: namines-backup [run|list|verify [dosya]|restore <dosya>|clean]"
    exit 1
    ;;
esac
