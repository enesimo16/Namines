# ═══════════════════════════════════════════════════════════════════════════
# Namines — docker-compose.prod.yml İÇİN ÜRETİM ORTAM DEĞİŞKENLERİ
# ═══════════════════════════════════════════════════════════════════════════
# Kurulum:   cp .env.prod.example .env     (ardından HER "CHANGE_ME"yi doldur)
#
# Bu dosya yalnızca şablondur; gerçek değerlerle doldurulmuş '.env' ASLA commit edilmez.
# Zorunlu olanlar boş/eksikse `docker compose` açılışta hata verir (fail-closed).
# '__' ayracı .NET config hiyerarşisine map olur:  Jwt__Key  =>  Jwt:Key
# Ek (opsiyonel) backend ayarları için bkz. deploy/backend.env.example.
# ═══════════════════════════════════════════════════════════════════════════


# ─── Ağ geçidi (Caddy) ─────────────────────────────────────────────────────
# Domain yoksa localhost ya da ham IP (http://1.2.3.4) — HTTP olarak çalışır.
# Domain varsa (örn. namines.app) Caddy otomatik HTTPS kurar.
APP_DOMAIN=localhost

# Tarayıcının gördüğü adresler (build zamanında frontend/desk imajlarına gömülür).
# PUBLIC_API_URL sonuna '/api' dahil; PUBLIC_APP_URL yalnızca origin (sondaki '/' yok).
PUBLIC_APP_URL=http://localhost
PUBLIC_API_URL=http://localhost/api


# ─── ZORUNLU: PostgreSQL control DB ────────────────────────────────────────
# Üret:  openssl rand -base64 24   (URL/ConnectionString'i bozan ';' ve '=' içermesin)
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_USER=namines
POSTGRES_DB=namines_control


# ─── ZORUNLU: Redis (cache + SignalR backplane) ────────────────────────────
REDIS_PASSWORD=CHANGE_ME


# ─── ZORUNLU: JWT ──────────────────────────────────────────────────────────
# En az 32 karakter. Üret:  openssl rand -base64 48
# Değiştirirsen tüm mevcut oturumlar geçersiz olur.
JWT__KEY=CHANGE_ME


# ─── ZORUNLU: Şifreleme anahtarları ────────────────────────────────────────
# İKİSİ FARKLI OLMALI: aynı anahtar, birinin sızmasını ikisinin sızması yapar.
# Üret:  openssl rand -base64 32
# Kullanıcı DB bağlantı dizelerinin at-rest şifrelemesi (AES-256-GCM).
SECURITY_CONNECTION_ENCRYPTION_KEY=CHANGE_ME
# Vault yedek dosyalarının at-rest şifrelemesi.
VAULT_BACKUP_ENCRYPTION_KEY=CHANGE_ME


# ─── ZORUNLU: Backend'e `.env` üzerinden geçen ayarlar ─────────────────────
# Frontend'in TAM origin'i (CORS) — şema dahil, sondaki '/' olmadan.
App__FrontendUrl=http://localhost
# Aynı domain arkasında (Caddy) çalıştığı için false; frontend farklı site'taysa true + HTTPS.
Auth__CrossSiteCookie=false
Groq__ApiKey=CHANGE_ME
Groq__Model=llama-3.3-70b-versatile


# ─── Reverse proxy güveni (X-Forwarded-For) ────────────────────────────────
# Production'da backend yalnızca bu ağdan gelen X-Forwarded-* başlıklarına güvenir;
# yoksa açılışta HATA verir (login rate-limit'i sahte IP ile aşılmasın diye).
# Varsayılan Docker bridge aralığıdır; özel bir ağ kullanıyorsan CIDR'ını yaz.
FORWARDED_HEADERS_NETWORK=172.16.0.0/12


# ─── OPSİYONEL: PostHog analitik ───────────────────────────────────────────
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
# Frontend (build-time): tarayıcı anahtarı + same-origin ters proxy yolu.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=/ingest

# ─── Veri saklama (DataRetentionService, günlük, 5000'lik partiler) ─────────
# 0 / negatif = o tablonun temizliği KAPALI. Boş bırakırsan varsayılan geçerli.
Retention__Enabled=true
Retention__GatewayAuditDays=365
Retention__SqlExecutionAuditDays=365
# Faturalama/vergi kaydı: varsayılan 7 yıl; 400 günün altına İNDİRİLEMEZ.
Retention__UsageEventDays=2557
Retention__ChangeRequestAuditDays=730
Retention__StripeWebhookDays=180
# Geri bildirimler varsayılan olarak saklanır (0). Silmek için gün sayısı yaz.
Retention__FeedbackDays=0

# ─── Bağlantı havuzu / zaman aşımı (kontrol DB) ─────────────────────────────
# Bağlantı dizesinde açıkça yazılan değer bunları ezer.
Database__MaxPoolSize=50
Database__CommandTimeoutSeconds=30
Database__ConnectTimeoutSeconds=15
Database__KeepaliveSeconds=30

# ─── Opsiyonel: en az yetkili DB rolleri (deploy/sql/roles.sql) ─────────────
# Yalnızca `--migrate` adımı bu bağlantıyı (namines_migrator) kullanır; uygulama
# DefaultConnection (namines_app, yalnızca DML) ile çalışır. Boşsa DefaultConnection kullanılır.
# ConnectionStrings__Migrations=Host=namines-control-db;Port=5432;Database=namines_control;Username=namines_migrator;Password=CHANGE_ME
