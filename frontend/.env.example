# ═══════════════════════════════════════════════════════════════════════════
# Namines Frontend — Environment Variables (Next.js / Vercel)
# ═══════════════════════════════════════════════════════════════════════════

# [ZORUNLU - Production] Backend API Kök Adresi (sonuna /api EKLENMEZ)
# Örnek: https://api.namines.com veya https://namines-api.koyeb.app
NEXT_PUBLIC_API_URL=http://localhost:5000

# [ÖNERİLEN - Production] Frontend Yayın Alan Adı (Sitemap, Robots ve Open Graph için)
# Örnek: https://namines.app veya https://projeniz.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# [OPSİYONEL] Namines Desk Veri Yönetim Paneli URL'i
# Varsayılan: http://localhost:3200
NEXT_PUBLIC_DESK_URL=http://localhost:3200
