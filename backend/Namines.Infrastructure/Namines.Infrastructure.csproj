<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Namines.Core\Namines.Core.csproj" />
    <!-- Tek yonlu: Vault, Infrastructure'i GORMEZ. Yedekleme modulunun
         veritabanina/kimlige bagimli hale gelmesini derleyici engelliyor. -->
    <ProjectReference Include="..\Namines.Vault\Namines.Vault.csproj" />
    <!-- Ayni tek yonlu kural: Ground da Infrastructure'i GORMEZ. -->
    <ProjectReference Include="..\Namines.Ground\Namines.Ground.csproj" />
    <!-- Flow ve Desk modulleri: modular monolith sinirlari -->
    <ProjectReference Include="..\Namines.Flow\Namines.Flow.csproj" />
    <ProjectReference Include="..\Namines.Desk\Namines.Desk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- TypeSql/DefaultValueSql bilinçli olarak internal — dış API yüzeyi değiller.
         Testler onları doğrudan çağırabilsin diye derleme birimini test projesine açıyoruz. -->
    <InternalsVisibleTo Include="Namines.Tests" />
    <!-- Ham Docker.DotNet kullanan testler ayrı projede (Testcontainers DLL çakışması). -->
    <InternalsVisibleTo Include="Namines.Tests.RunTests" />
  </ItemGroup>

  <ItemGroup>
    <!-- PII redaksiyon enricher'ı burada yaşıyor: log yazan her yerde (API,
         arka plan servisleri) aynı kapıdan geçmesi gerekiyor. -->
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="8.8.0" />
    <PackageReference Include="Polly.Core" Version="8.4.2" />
    <PackageReference Include="Serilog" Version="4.1.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Docker.DotNet" Version="3.125.15" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="8.0.8" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.8" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.8" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.8">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />
    <PackageReference Include="MySqlConnector" Version="2.6.1" />
    <!-- Geçişli CVE alt sınırları (bkz. backend/Directory.Build.props): SQLitePCLRaw (Microsoft.Data.Sqlite), Pkcs (SqlClient/Oracle). -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.12" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="8.0.2" />
    <!-- EF Design araç zinciri System.Text.Json 8.0.4 çekiyor; çalışma zamanına/bağımlılara SIZMASIN (Mcp 10.x ister). -->
    <PackageReference Include="System.Text.Json" Version="8.0.5" PrivateAssets="all" />
    <PackageReference Include="Npgsql" Version="8.0.7" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.8" />
    <PackageReference Include="Oracle.ManagedDataAccess.Core" Version="23.26.200" />
    <PackageReference Include="QuestPDF" Version="2026.5.0" />
    <PackageReference Include="StackExchange.Redis" Version="2.8.16" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
