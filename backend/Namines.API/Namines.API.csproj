<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Sırlar tek .env dosyasında tutulur (DotNetEnv ile yüklenir); user-secrets kullanılmaz. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AspNetCore.HealthChecks.NpgSql" Version="8.0.1" />
    <PackageReference Include="AspNetCore.HealthChecks.UI.Client" Version="8.0.1" />
    <PackageReference Include="AspNetCore.HealthChecks.Uris" Version="8.0.1" />
    <PackageReference Include="DotNetEnv" Version="3.2.0" />
    <PackageReference Include="HtmlAgilityPack" Version="1.12.4" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.8" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" Version="8.0.11" />
    <!-- 21 §1: satıcı-bağımsız enstrümantasyon.

         OTLP DIŞA AKTARICISI BİLİNÇLİ OLARAK YOK. OpenTelemetry.Exporter.
         OpenTelemetryProtocol'ün denenen tüm sürümleri (1.9-1.12) NU1902 ile
         bilinen bir güvenlik açığı bildiriyor. Projede henüz bir OTel Collector
         yok, yani paketin bugün sağlayacağı somut bir fayda da yok — 0 uyarılı
         bir derlemeye açıklı bir bağımlılık sokmak net bir gerileme olurdu.
         Collector kurulduğunda ve açık kapandığında eklenecek; o zamana kadar
         metrikler Prometheus scrape ucundan okunuyor. -->
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.10.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.10.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.10.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.10.0" />
    <PackageReference Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" Version="1.10.0-beta.1" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageReference Include="Serilog.Enrichers.Environment" Version="3.0.1" />
    <PackageReference Include="Serilog.Enrichers.Thread" Version="4.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Stripe.net" Version="46.2.1" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.1.7" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Namines.Core\Namines.Core.csproj" />
    <ProjectReference Include="..\Namines.Infrastructure\Namines.Infrastructure.csproj" />
  </ItemGroup>

</Project>
