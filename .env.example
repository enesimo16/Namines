# ================================================================
# Namines — Environment Variables (ÖRNEK ŞABLON)
# ================================================================
# Kopyalayın:  cp .env.example .env  ve gerçek değerleri girin.
# .env GIT'E EKLENMEZ (.gitignore'da). Tüm sırların TEK kaynağıdır.
# Backend başlangıçta DotNetEnv ile otomatik yükler; docker-compose
# ise env_file olarak kullanır. '__' ayracı .NET hiyerarşisine map olur
# (ör. Jwt__Key => Jwt:Key).
# ================================================================

# ── JWT (en az 32 karakter güçlü bir anahtar) ──
Jwt__Key=en_az_32_karakter_guvenli_anahtariniz_buraya
Jwt__Issuer=NaminesServer
Jwt__Audience=NaminesClient

# ── Groq — https://console.groq.com/keys ──
Groq__ApiKey=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
Groq__Model=llama-3.3-70b-versatile

# ── Gemini (opsiyonel) ──
Gemini__ApiKey=

# ── Stripe (opsiyonel — ödeme özellikleri için) ──
Stripe__SecretKey=
Stripe__WebhookSecret=
Stripe__PublishableKey=
Stripe__ProPriceId=

# ── Database Executor SSRF override ──
# Yerel geliştirmede localhost/private DB'ye push için true; PRODUCTION'da false bırakın.
Executor__AllowPrivateHosts=false
