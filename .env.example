# ═══════════════════════════════════════════════════════════════════════════
# Namines — YEREL GELİŞTİRME + docker-compose için TEK SIR KAYNAĞI
# ═══════════════════════════════════════════════════════════════════════════
# Kurulum:   cp .env.example .env     (ardından değerleri doldur)
#
# Bu dosya git'e girer (sadece örnek). '.env' ASLA commit edilmez.
#
# '__' ayracı .NET config hiyerarşisine map olur:  Jwt__Key  =>  Jwt:Key
# Backend başlangıçta .env'i DotNetEnv ile otomatik yükler.
#
# PRODUCTION DEPLOY için bu dosyayı KULLANMA — bkz:
#   deploy/backend.env.example     (API sunucusu)
#   deploy/frontend.env.example    (Next.js / Vercel)
# ═══════════════════════════════════════════════════════════════════════════


# ─── ZORUNLU: JWT ──────────────────────────────────────────────────────────
# En az 32 karakter. Üretmek için:  openssl rand -base64 48
# Production'da tanımsızsa uygulama başlamaz (fail-closed).
Jwt__Key=CHANGE_ME_en_az_32_karakterlik_rastgele_bir_deger
Jwt__Issuer=NaminesServer
Jwt__Audience=NaminesClient


# ─── ZORUNLU: Groq (ana AI sağlayıcı) ──────────────────────────────────────
# Ücretsiz anahtar: https://console.groq.com/keys
Groq__ApiKey=gsk_CHANGE_ME
Groq__Model=llama-3.3-70b-versatile


# ─── OPSİYONEL: Gemini (vision / görselden şema) ───────────────────────────
# Boş bırakılırsa görsel yükleme özelliği devre dışı kalır.
# Anahtar: https://aistudio.google.com/apikey
Gemini__ApiKey=


# ─── OPSİYONEL: Stripe (Pro plan) ──────────────────────────────────────────
# Hepsi boşsa ödeme özellikleri sessizce devre dışı kalır; geri kalan her şey çalışır.
# Anahtarlar: https://dashboard.stripe.com/apikeys
Stripe__SecretKey=
Stripe__WebhookSecret=
Stripe__PublishableKey=
Stripe__ProPriceId=


# ─── Uygulama ──────────────────────────────────────────────────────────────
# Frontend origin'i. Backend'in CORS izin listesi buradan beslenir.
App__FrontendUrl=http://localhost:3000


# ─── AI token havuzu ───────────────────────────────────────────────────────
# Paylaşımlı günlük havuz + kullanıcı-başı tavan. Havuz veya tavan dolunca
# istekler bloklanmaz — ücretsiz yerel motora düşer.
AiPool__DailyTokenPool=100000
AiPool__PerUserDailyTokens=20000


# ─── Güvenlik ──────────────────────────────────────────────────────────────
# SSRF koruması. 'true' YALNIZCA yerel geliştirme içindir (localhost'taki bir
# veritabanına bağlanabilmek için). Production'da MUTLAKA 'false' olmalı.
Executor__AllowPrivateHosts=true

# Frontend ile API farklı site'lardaysa (ör. Vercel + Railway) 'true' yap.
# Aynı host veya aynı ana domain'in subdomain'lerinde 'false' kalmalı.
Auth__CrossSiteCookie=false


# ─── Frontend (Next.js) ────────────────────────────────────────────────────
# API'nin kök adresi. SONUNA '/api' EKLEME — kod zaten ekliyor.
NEXT_PUBLIC_API_URL=http://localhost:5000


# ─── Streamlit geliştirici paketi için düz değişken ────────────────────────
# Üretilen paketin çalışması için Groq anahtarının '__'suz hali.
GROQ_API_KEY=gsk_CHANGE_ME

# ── Dev hesabi (gorunmeyen, sinirsiz) -- DevAccountSeeder ──────────────────────────
# Acilista bu hesap olusturulur ya da tazelenir; butun sinirlar kapali
# (PlanTier.Dev: sinirsiz token, sinirsiz branch DB, sinirsiz ephemeral kosu).
#
# GERCEK DEGERLER .env DOSYASINDA, BU DOSYADA DEGIL. .env .gitignore icinde,
# bu ornek dosya ise depoya giriyor -- buraya gercek parola yazma.
#
# Ikisi de bos birakilirsa hicbir hesap olusturulmaz. Koda gomulu bir
# varsayilan parola, uretimde herkesin bildigi bir arka kapiya donerdi.
#
# .env'deki parola TEK DOGRU KAYNAK: uyusmuyorsa hesabin parolasi acilista
# buradaki degere cekilir.
Dev__Email=
Dev__Password=

# ── Stripe: iki odenen plan ──────────────────────────────────────────────────
# Fiyat (7.5$/ay, 20$/ay) Stripe Dashboard'da tanimlanir, kodda degil. Buradaki
# ID'ler o fiyatlarin Stripe tarafindaki referanslari.
Stripe__ProPriceId=
Stripe__TeamPriceId=
