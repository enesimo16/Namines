# ═══════════════════════════════════════════════════════════════════════════
# Namines — YEREL GELİŞTİRME + docker-compose için TEK SIR KAYNAĞI
# ═══════════════════════════════════════════════════════════════════════════
# Kurulum:   cp .env.example .env     (ardından değerleri doldur)
#
# Bu dosya git'e girer (sadece örnek). '.env' ASLA commit edilmez.
#
# '__' ayracı .NET config hiyerarşisine map olur:  Jwt__Key  =>  Jwt:Key
# Backend başlangıçta .env'i DotNetEnv ile otomatik yükler.
#
# PRODUCTION DEPLOY için bu dosyayı KULLANMA — bkz:
#   deploy/backend.env.example     (API sunucusu)
#   deploy/frontend.env.example    (Next.js / Vercel)
# ═══════════════════════════════════════════════════════════════════════════


# ─── ZORUNLU: JWT ──────────────────────────────────────────────────────────
# En az 32 karakter. Üretmek için:  openssl rand -base64 48
# Production'da tanımsızsa uygulama başlamaz (fail-closed).
Jwt__Key=CHANGE_ME_en_az_32_karakterlik_rastgele_bir_deger
Jwt__Issuer=NaminesServer
Jwt__Audience=NaminesClient


# ─── ZORUNLU: Groq (ana AI sağlayıcı) ──────────────────────────────────────
# Ücretsiz anahtar: https://console.groq.com/keys
Groq__ApiKey=gsk_CHANGE_ME
Groq__Model=llama-3.3-70b-versatile


# ─── OPSİYONEL: Gemini (vision / görselden şema) ───────────────────────────
# Boş bırakılırsa görsel yükleme özelliği devre dışı kalır.
# Anahtar: https://aistudio.google.com/apikey
Gemini__ApiKey=


# ─── OPSİYONEL: Stripe (Pro plan) ──────────────────────────────────────────
# Hepsi boşsa ödeme özellikleri sessizce devre dışı kalır; geri kalan her şey çalışır.
# Anahtarlar: https://dashboard.stripe.com/apikeys
Stripe__SecretKey=
Stripe__WebhookSecret=
Stripe__PublishableKey=
Stripe__ProPriceId=


# ─── Uygulama ──────────────────────────────────────────────────────────────
# Frontend origin'i. Backend'in CORS izin listesi buradan beslenir.
App__FrontendUrl=http://localhost:3000


# ─── AI token havuzu ───────────────────────────────────────────────────────
# Paylaşımlı günlük havuz + kullanıcı-başı tavan. Havuz veya tavan dolunca
# istekler bloklanmaz — ücretsiz yerel motora düşer.
AiPool__DailyTokenPool=100000
AiPool__PerUserDailyTokens=20000


# ─── Güvenlik ──────────────────────────────────────────────────────────────
# SSRF koruması: özel/loopback/ayrılmış adreslere veritabanı bağlantısı.
#
# CIFT KAPI: yalnizca (Development ortami) VE (bu bayrak true) ise gevser.
# Tek basina config bayragi, prod'a yanlislikla kopyalanan bir env
# degiskeniyle korumayi kapatabilirdi.
Security__AllowPrivateDbHosts=true

# ARTIK KULLANILMIYOR. Once DatabaseExecutorService'in kendi TEK KAPILI
# bayragiydi (yalnizca config'e bakiyordu, ortama bakmiyordu) -- yani en
# tehlikeli uc en zayif kapiyi kullaniyordu. Executor artik yukaridaki ortak
# politikadan geciyor. Satir, eski .env'lerde kafa karistirmasin diye burada
# birakildi; hicbir etkisi yok.
# Executor__AllowPrivateHosts=

# Veritabani EGRESS ALLOWLIST -- DNS rebinding'in gercek cevabi.
#
# BOS ise: ozel/ayrilmis adresler reddedilir ama herhangi bir PUBLIC hedefe
# baglanilabilir. DOLU ise: yalnizca buradaki hedeflere baglanilabilir.
#
# Neden gerekli: SsrfGuard host'u dogrularken DNS'i cozuyor, surucu ise
# baglanirken YENIDEN cozuyor. Arada cevap degisebilir (TOCTOU / DNS
# rebinding) ve bu pencereyi kodla kapatmak TLS sertifika dogrulamasini
# bozmadan mumkun degil. Allowlist yarisi ANLAMSIZ kiliyor: saldirganin alan
# adi listede olmadigi icin hangi IP'ye cozuldugu fark etmiyor.
#
# Bicimler: db.ornek.com  |  *.ornek.com (kok DAHIL)  |  203.0.113.5
# Ayirici: virgul, noktali virgul ya da satir sonu.
#
# URETIMDE DOLDURULMASI ONERILIR.
Security__DbEgress__AllowedHosts=

# Frontend ile API farklı site'lardaysa (ör. Vercel + Railway) 'true' yap.
# Aynı host veya aynı ana domain'in subdomain'lerinde 'false' kalmalı.
Auth__CrossSiteCookie=false

# Sizdirilmis parola kontrolu (Have I Been Pwned).
#
# PAROLA SUNUCUDAN CIKMIYOR: parolanin SHA-1'inin yalnizca ILK 5 KARAKTERI
# gonderiliyor (k-anonimlik), API o on eke uyan ~800 hash donduruyor ve
# eslestirme yerelde yapiliyor. HIBP hangi parolanin soruldugunu bilemiyor.
#
# Neden gerekli: 12 karakterlik uzunluk kurali tek basina yetmiyor.
# Olculdu (2026-09-10): "Password123456" 14 karakter, uzunluk kuralini
# GECIYOR -- ve 42.513 sizintida var.
#
# Dis aga erisimi olmayan (air-gapped) kurulumlarda 'false' yapin. Tanimsizsa
# ACIK kabul edilir. Ag hatasinda parola KABUL EDILIR (fail-open) ama her
# basarisizlik loga ERROR olarak yazilir -- sessizce devre disi kalmaz.
Security__PwnedPasswordCheck__Enabled=true


# ─── Frontend (Next.js) ────────────────────────────────────────────────────
# API'nin kök adresi. SONUNA '/api' EKLEME — kod zaten ekliyor.
NEXT_PUBLIC_API_URL=http://localhost:5000


# ─── Streamlit geliştirici paketi için düz değişken ────────────────────────
# Üretilen paketin çalışması için Groq anahtarının '__'suz hali.
GROQ_API_KEY=gsk_CHANGE_ME

# ── Dev hesabi (gorunmeyen, sinirsiz) -- DevAccountSeeder ──────────────────────────
# Acilista bu hesap olusturulur ya da tazelenir; butun sinirlar kapali
# (PlanTier.Dev: sinirsiz token, sinirsiz branch DB, sinirsiz ephemeral kosu).
#
# GERCEK DEGERLER .env DOSYASINDA, BU DOSYADA DEGIL. .env .gitignore icinde,
# bu ornek dosya ise depoya giriyor -- buraya gercek parola yazma.
#
# Ikisi de bos birakilirsa hicbir hesap olusturulmaz. Koda gomulu bir
# varsayilan parola, uretimde herkesin bildigi bir arka kapiya donerdi.
#
# .env'deki parola TEK DOGRU KAYNAK: uyusmuyorsa hesabin parolasi acilista
# buradaki degere cekilir.
Dev__Email=
Dev__Password=

# ── Stripe: iki odenen plan ──────────────────────────────────────────────────
# Fiyat (7.5$/ay, 20$/ay) Stripe Dashboard'da tanimlanir, kodda degil. Buradaki
# ID'ler o fiyatlarin Stripe tarafindaki referanslari.
Stripe__ProPriceId=
Stripe__TeamPriceId=

# ── Namines Vault ─────────────────────────────────────────────────────────────
# Yedek dosyalarinin at-rest sifreleme anahtari (AES-256-GCM). En az 32 karakter,
# ornegin: openssl rand -base64 32
#
# Security__ConnectionEncryptionKey ile AYNI OLMAMALI. Ayni anahtar kullanilirsa
# birinin sizmasi ikisinin sizmasi olurdu: baglanti dizesini cozebilen biri, o
# baglantinin butun gecmis yedeklerini de cozebilirdi.
#
# Bos birakilirsa Vault ACIKCA durur -- sifresiz yedek YAZMAZ.
Vault__BackupEncryptionKey=

# Yedeklerin durdugu dizin -- YALNIZCA nesne depo yapilandirilmamissa kullanilir.
# Bos ise uygulamanin yaninda vault-backups/ olusturulur.
Vault__StoragePath=

# ── Nesne depo (S3 uyumlu) ────────────────────────────────────────────────────
# Vault__S3__Bucket TANIMLIYSA yedekler diske DEGIL buraya yazilir. Sunucu
# diskinin uc sorunu boylece ortadan kalkiyor: disk yedek boyutuyla dolmuyor,
# birden fazla instance ayni dosyayi goruyor ve sunucu yeniden kurulsa da
# yedekler kaliyor.
#
# Ayni ayarlar hem AWS S3 hem MinIO icin gecerli -- MinIO S3 protokolunu
# konusuyor, dolayisiyla tek uygulama ikisini de karsiliyor.
#
# MinIO / S3 uyumlu sunucu icin ServiceUrl VER:
#   Vault__S3__ServiceUrl=http://minio:9000
# Gercek AWS icin ServiceUrl'i BOS BIRAK ve Region ver.
#
# Hangi deponun kullanildigi Vault ekraninda acikca yaziyor.
Vault__S3__Bucket=
Vault__S3__AccessKey=
Vault__S3__SecretKey=
Vault__S3__ServiceUrl=
Vault__S3__Region=us-east-1

# -- Istemci imajlari (motor basina) -------------------------------------------
# Yedek/geri yukleme, veritabani istemcisini TASIYAN kisa omurlu bir
# konteynerde calisiyor; API sunucusuna pg_dump/mysqldump kurmak gerekmiyor.
#
# Imaj etiketi SUNUCU SURUMUNDEN KUCUK OLMAMALI: eski bir istemci yeni bir
# sunucuyu reddeder (ve bu iyi -- sessizce eksik dump almaktansa).
#
# MySQL ve MariaDB icin AYRI imajlar: MySQL 8 istemcisiyle MariaDB'ye (ya da
# tersine) dump almak, kimlik dogrulama eklentisi ve surum-ozel deyimler
# yuzunden sessizce eksik/bozuk cikti verebiliyor.
Vault__PostgresImage=postgres:17-alpine
Vault__MySqlImage=mysql:8.0
Vault__MariaDbImage=mariadb:10.6

# ── Namines Ground: yonetilen veritabani ──────────────────────────────────────
# Yerel saglayici: CREATE DATABASE ve CREATE ROLE yetkisi olan baglanti.
# Control DB'ninkinden AYRI bir anahtar: kiraci veritabanlarini Namines'in
# kendi verisiyle ayni yetki alanina sokmak, operatorun ikisini ayirma
# imkanini elinden alirdi. Bos ise yerel saglayici kullanilamaz.
Ground__LocalPostgres__AdminConnectionString=

# Kullaniciya verilecek baglantidaki host. Sunucu bize localhost gorunurken
# kullanicinin uygulamasina genel bir adla gorunmesi gerekebilir. Bos ise
# yonetici baglantisindaki adres kullanilir.
Ground__LocalPostgres__PublicHost=

# Neon saglayicisi (opsiyonel). Bos ise Neon secenegi "yapilandirilmamis"
# gorunur ama listede kalir -- kullanici secenegin var oldugunu ve neyin
# eksik oldugunu gorsun.
Ground__Neon__ApiKey=

# Neon iki tur API anahtari veriyor: KISISEL hesap anahtari ve ORGANIZASYON
# anahtari. Organizasyon anahtariyla proje listelemek/olusturmak org_id
# olmadan "400 org_id is required" ile reddediliyor (canli denendi, 2026-09-09).
# neon.tech'te API anahtarinin turu organizasyon ise burayi doldur; kisisel
# hesap anahtarinda bos birak.
#
# Kimligi bulmak icin: https://console.neon.tech/api/v2/users/me/organizations
# (Authorization: Bearer <anahtar> ile) -- donen organizations[0].id.
Ground__Neon__OrgId=

Ground__Neon__Region=aws-eu-central-1

# Silme bekleme penceresi (gun). Bu sure boyunca silme GERI ALINABILIR.
# 7 gun: daha kisasi (24 saat) tatildeki bir ekibi kurtaramaz, daha uzunu
# silinmis sayilan kaynagin faturasini aylarca surdurur.
Ground__DeleteGraceDays=7
