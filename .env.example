# ================================================================
# Namines — Environment Variables Example
# ================================================================
# Bu dosyayı kopyalayın: cp .env.example .env
# .env dosyasını GIT'E EKLEMEYIN — .gitignore'da zaten mevcut.
# ================================================================

# Groq API Key — https://console.groq.com/keys adresinden alın
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# JWT Secret Key — en az 32 karakter güçlü bir anahtar
JWT_KEY=en_az_32_karakter_guvenli_anahtariniz_buraya

# JWT Issuer / Audience (opsiyonel — varsayılan değerler kullanılır)
# JWT_ISSUER=NaminesServer
# JWT_AUDIENCE=NaminesClient
