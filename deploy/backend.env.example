# ═══════════════════════════════════════════════════════════════════════════
# Namines — BACKEND (API) PRODUCTION ORTAM DEĞİŞKENLERİ
# ═══════════════════════════════════════════════════════════════════════════
# Kullanım: bu değişkenleri deploy platformunun "Environment Variables"
# paneline gir (Railway / Render / Fly.io / Azure), ya da VPS'te bir
# .env dosyasına koyup docker-compose'a env_file olarak ver.
#
# '__' ayracı .NET config hiyerarşisine map olur:  Jwt__Key  =>  Jwt:Key
# Bu dosyayı GERÇEK değerlerle DOLDURUP COMMIT ETME — sadece bir şablondur.
# ═══════════════════════════════════════════════════════════════════════════


# ─── Çalışma ortamı ────────────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Production

# Kestrel bind adresi. '+' = tüm arayüzler. Container'da ZORUNLU —
# 'localhost' olursa servis dışarıdan erişilemez.
# NOT: Railway/Render gibi platformlar PORT değişkenini kendi atar; o durumda
# bu satırı SİL, uygulama PORT'u otomatik kullanır.
ASPNETCORE_URLS=http://+:8080


# ─── ZORUNLU: JWT ──────────────────────────────────────────────────────────
# En az 32 karakter. Üret:  openssl rand -base64 48
# Production'da tanımsızsa uygulama BAŞLAMAZ (fail-closed — bilinçli tasarım).
# Bu değeri değiştirirsen tüm mevcut oturumlar geçersiz olur.
Jwt__Key=
Jwt__Issuer=NaminesServer
Jwt__Audience=NaminesClient


# ─── ZORUNLU: Groq (ana AI sağlayıcı) ──────────────────────────────────────
# https://console.groq.com/keys
Groq__ApiKey=
Groq__Model=llama-3.3-70b-versatile


# ─── ZORUNLU: Frontend origin (CORS) ───────────────────────────────────────
# Frontend'in TAM origin'i — şema dahil, sondaki '/' olmadan.
# Production'da localhost otomatik eklenmez; burası yanlışsa tarayıcı
# isteklerinin tamamı CORS'a takılır.
# Örnek: https://namines.vercel.app
App__FrontendUrl=

# Birden fazla origin gerekiyorsa (ör. apex + www) bunları kullan:
# Cors__AllowedOrigins__0=https://namines.app
# Cors__AllowedOrigins__1=https://www.namines.app


# ─── ZORUNLU: Auth cookie site politikası ──────────────────────────────────
# Frontend ve API FARKLI site'lardaysa (ör. frontend vercel.app + API
# railway.app) 'true' YAP. Aksi halde tarayıcı auth cookie'sini isteklere
# eklemez: login başarılı görünür ama sonraki her istek anonim kalır.
#   true  → SameSite=None + Secure  (HTTPS ZORUNLU)
#   false → SameSite=Lax            (aynı domain / subdomain kurulumu)
Auth__CrossSiteCookie=true


# ─── Veritabanı ────────────────────────────────────────────────────────────
# SQLite dosya yolu. Kalıcı bir disk/volume'a işaret ETMELİ, aksi halde
# her deploy'da tüm kullanıcı hesapları ve projeler silinir.
ConnectionStrings__DefaultConnection=Data Source=/app/data/namines_auth.db


# ─── OPSİYONEL: Gemini (vision / görselden şema) ───────────────────────────
# Boşsa görsel yükleme özelliği devre dışı kalır, diğer her şey çalışır.
Gemini__ApiKey=


# ─── OPSİYONEL: Stripe (Pro plan) ──────────────────────────────────────────
# Hepsi boşsa ödeme özellikleri sessizce kapanır.
# Webhook secret'ı Stripe Dashboard → Developers → Webhooks'tan alınır ve
# endpoint olarak  https://<api-domain>/api/stripewebhook  tanımlanır.
Stripe__SecretKey=
Stripe__WebhookSecret=
Stripe__PublishableKey=
Stripe__ProPriceId=


# ─── AI token havuzu ───────────────────────────────────────────────────────
# Paylaşımlı günlük havuz + kullanıcı-başı tavan. Dolunca istekler bloklanmaz,
# ücretsiz yerel motora düşer. Trafik arttıkça havuzu büyüt.
AiPool__DailyTokenPool=100000
AiPool__PerUserDailyTokens=20000


# ─── Güvenlik ──────────────────────────────────────────────────────────────
# SSRF koruması. Production'da MUTLAKA 'false' — 'true' olursa kullanıcılar
# sunucunun iç ağına ve cloud metadata servisine (169.254.169.254) erişebilir.
Executor__AllowPrivateHosts=false


# ─── Streamlit geliştirici paketi için düz değişken ────────────────────────
# Üretilen paketin çalışması için Groq anahtarının '__'suz hali.
GROQ_API_KEY=
